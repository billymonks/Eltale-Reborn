<template name="config-menu__general">
    <head>
    </head>
    <body>
        <form class="config__form" id="conf-general__form">
            <div class="config__hz-wrapper" id="conf-general__hz-wrapper">
                <!-- Options -->
                <div class="config__wrapper" data-event-mouseout="set_cur_config_index(-1)" id="conf-general__wrapper">
                    <!-- rumble strength -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(1)">
                        <label class="config-option__title">Rumble Strength</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{rumble_strength}}%</label>
                            <input
                                class="nav-vert"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(1)"
                                id="rumble_strength_input"
                                type="range"
                                min="0"
                                max="100"
                                style="flex: 1; margin: 0dp;"
                                data-value="rumble_strength"
                            />
                        </div>
                    </div>
                    
                    <!-- joystick deadzone -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(4)">
                        <label class="config-option__title">Joystick Deadzone</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{joystick_deadzone}}%</label>
                            <input
                                class="nav-vert"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(4)"
                                id="joystick_deadzone_input"
                                type="range"
                                min="0"
                                max="100"
                                style="flex: 1; margin: 0dp; nav-down: #camera_turn_speed_input"
                                data-value="joystick_deadzone"
                            />
                        </div>
                    </div>

                    <!-- the camera stick: speeds and invert -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(8)">
                        <label class="config-option__title">Camera Turn Speed</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{camera_turn_speed}}%</label>
                            <input
                                class="nav-vert"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(8)"
                                id="camera_turn_speed_input"
                                type="range"
                                min="10"
                                max="200"
                                step="5"
                                style="flex: 1; margin: 0dp;"
                                data-value="camera_turn_speed"
                            />
                        </div>
                    </div>

                    <div class="config-option" data-event-mouseover="set_cur_config_index(9)">
                        <label class="config-option__title">Camera Tilt Speed</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{camera_tilt_speed}}%</label>
                            <input
                                class="nav-vert"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(9)"
                                id="camera_tilt_speed_input"
                                type="range"
                                min="10"
                                max="200"
                                step="5"
                                style="flex: 1; margin: 0dp; nav-down: #camera_invert_turn_mode_on"
                                data-value="camera_tilt_speed"
                            />
                        </div>
                    </div>

                    <div class="config-option" data-event-mouseover="set_cur_config_index(10)">
                        <label class="config-option__title">Invert Camera Turn</label>
                        <div class="config-option__list">
                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(10)"
                                name="camera_invert_turn_mode"
                                data-checked="camera_invert_turn_mode"
                                value="On"
                                id="camera_invert_turn_mode_on"
                                style="nav-up: #camera_tilt_speed_input; nav-down: #camera_invert_tilt_mode_on"
                            />
                            <label class="config-option__tab-label" for="camera_invert_turn_mode_on">On</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(10)"
                                name="camera_invert_turn_mode"
                                data-checked="camera_invert_turn_mode"
                                value="Off"
                                id="camera_invert_turn_mode_off"
                                style="nav-up: #camera_tilt_speed_input; nav-down: #camera_invert_tilt_mode_off"
                            />
                            <label class="config-option__tab-label" for="camera_invert_turn_mode_off">Off</label>
                        </div>
                    </div>

                    <div class="config-option" data-event-mouseover="set_cur_config_index(11)">
                        <label class="config-option__title">Invert Camera Tilt</label>
                        <div class="config-option__list">
                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(11)"
                                name="camera_invert_tilt_mode"
                                data-checked="camera_invert_tilt_mode"
                                value="On"
                                id="camera_invert_tilt_mode_on"
                                style="nav-up: #camera_invert_turn_mode_on; nav-down: #bg_input_enabled"
                            />
                            <label class="config-option__tab-label" for="camera_invert_tilt_mode_on">On</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(11)"
                                name="camera_invert_tilt_mode"
                                data-checked="camera_invert_tilt_mode"
                                value="Off"
                                id="camera_invert_tilt_mode_off"
                                style="nav-up: #camera_invert_turn_mode_off; nav-down: #bg_input_disabled"
                            />
                            <label class="config-option__tab-label" for="camera_invert_tilt_mode_off">Off</label>
                        </div>
                    </div>

                    <!-- background input -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(5)" id="conf-general__Background-Input">
                        <label class="config-option__title">Background Input</label>
                        <div class="config-option__list">
                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(5)"
                                name="background_input_mode"
                                data-checked="background_input_mode"
                                value="On"
                                id="bg_input_enabled"
                                style="nav-up: #camera_invert_tilt_mode_on; nav-down: #film_grain_mode_on"
                            />
                            <label class="config-option__tab-label" for="bg_input_enabled">On</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(5)"
                                name="background_input_mode"
                                data-checked="background_input_mode"
                                value="Off"
                                id="bg_input_disabled"
                                style="nav-up: #camera_invert_tilt_mode_off; nav-down: #film_grain_mode_off"
                            />
                            <label class="config-option__tab-label" for="bg_input_disabled">Off</label>
                        </div>
                    </div>

                    <!-- Film Grain -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(6)">
                        <label class="config-option__title">Film Grain</label>
                        <div class="config-option__list">
                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(6)"
                                name="film_grain_mode"
                                data-checked="film_grain_mode"
                                value="On"
                                id="film_grain_mode_on"
                                style="nav-up: #bg_input_enabled; nav-down: #rt_debug_keys_mode_on"
                            />
                            <label class="config-option__tab-label" for="film_grain_mode_on">On</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(6)"
                                name="film_grain_mode"
                                data-checked="film_grain_mode"
                                value="Off"
                                id="film_grain_mode_off"
                                style="nav-up: #bg_input_disabled; nav-down: #rt_debug_keys_mode_off"
                            />
                            <label class="config-option__tab-label" for="film_grain_mode_off">Off</label>
                        </div>
                    </div>

                    <!-- Ray Tracing Debug Keys -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(7)">
                        <label class="config-option__title">Ray Tracing Debug Keys</label>
                        <div class="config-option__list">
                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(7)"
                                name="rt_debug_keys_mode"
                                data-checked="rt_debug_keys_mode"
                                value="On"
                                id="rt_debug_keys_mode_on"
                                style="nav-up: #film_grain_mode_on;"
                            />
                            <label class="config-option__tab-label" for="rt_debug_keys_mode_on">On</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(7)"
                                name="rt_debug_keys_mode"
                                data-checked="rt_debug_keys_mode"
                                value="Off"
                                id="rt_debug_keys_mode_off"
                                style="nav-up: #film_grain_mode_off;"
                            />
                            <label class="config-option__tab-label" for="rt_debug_keys_mode_off">Off</label>
                        </div>
                    </div>

                </div>

                <!-- Descriptions -->
                <div class="config__wrapper">
                    <p data-if="cur_config_index == 0">
                        Controls how targeting enemies and objects works. <b>Switch</b> will start or stop targeting each time the target button is pressed. <b>Hold</b> will start when the target button is pressed and stop when the button is released. 
                    </p>
                    <p data-if="cur_config_index == 1">
                        Controls the strength of rumble when using a controller that supports it. <b>Setting this to zero will disable rumble.</b>
                    </p>
                    <p data-if="cur_config_index == 2">
                        Controls the sensitivity of gyro aiming when using items in first person for controllers that support it. <b>Setting this to zero will disable gyro.</b>
                        <br />
                        <br />
                        <b>Note: To recalibrate controller gyro, set the controller down on a still, flat surface for 5 seconds.</b>
                    </p>
                    <p data-if="cur_config_index == 3">
                        Controls the sensitivity of mouse aiming when using items in first person. <b>Setting this to zero will disable mouse aiming.</b>
                        <br />
                        <br />
                        <b>Note: This option does not allow mouse buttons to activate items. Mouse aiming is intended to be used with inputs that are mapped to mouse movement, such as gyro on Steam Deck.</b>
                    </p>
                    <p data-if="cur_config_index == 4">
                        Applies a deadzone to joystick inputs.
                    </p>
                    <p data-if="cur_config_index == 5">
                        Allows the game to read controller input when out of focus.
                        <br/>
                        <b>This setting does not affect keyboard input.</b>
                    </p>
                    <p data-if="cur_config_index == 6">
                        Adds a visual effect that simulates the random grain you see in old film or high-ISO camera footage.
                        <br/>
                    </p>
                    <p data-if="cur_config_index == 7">
                        Enables the path tracing debug keys. <b>F9</b> writes a diagnostics report for the pixel under the mouse cursor to rt.log, and <b>F10</b> cycles the debug views.
                    </p>
                    <p data-if="cur_config_index == 8">
                        How fast the camera stick turns the camera left and right, in the field and in battle. <b>100%</b> is the default. Modern controls only.
                    </p>
                    <p data-if="cur_config_index == 9">
                        How fast the camera stick tilts the camera up and down, in the field and in battle. <b>100%</b> is the default. Modern controls only.
                    </p>
                    <p data-if="cur_config_index == 10">
                        Reverses the camera stick's left and right: pushing right turns the view to the left. <b>Off</b> is the default. Modern controls only.
                    </p>
                    <p data-if="cur_config_index == 11">
                        Reverses the camera stick's up and down: pushing up tilts the view down, like a flight stick. <b>Off</b> is the default. Modern controls only.
                    </p>
                </div>
            </div>
        </form>
    </body>
</template>
