<template name="config-menu__controls">
    <head>
    </head>
    <body>
        <form class="config__form" data-attr-cur-input="cur_input_row" data-attr-cur-binding-slot="active_binding_slot">
            <div class="config__header">
                <div class="config__header-left">
                    <button
                        class="toggle"
                        id="cont_kb_toggle"
                        data-class-toggle--checked="input_device_is_keyboard"
                        onclick="toggle_input_device"
                        style="nav-down: #input_row_button_0_0; nav-up: #tab_controls"
                    >
                        <div class="toggle__border" />
                        <div class="toggle__floater" />
                        <div class="toggle__icons">
                            <div class="toggle__icon toggle__icon--left"><div>␼</div></div>
                            <div class="toggle__icon toggle__icon--right"><div>␽</div></div>
                        </div>
                    </button>
                    <!-- The controller's controls style: Modern (the modern layout, the free camera) or Classic (Eltale
                         Reborn's original controls, unchanged), each with its own bindings. Left / right reach them from
                         the device toggle, A picks one, down goes to the list. Not shown for the keyboard. -->
                    <div class="controls-style" data-if="!input_device_is_keyboard">
                        <button
                            id="controls_style_modern"
                            class="controls-style__tab"
                            data-class-controls-style__tab--active="controls_style == 'Modern'"
                            data-event-click="set_controls_style('Modern')"
                            style="nav-up: #tab_controls; nav-down: #input_row_button_0_0"
                        >Modern controls</button>
                        <button
                            id="controls_style_classic"
                            class="controls-style__tab"
                            data-class-controls-style__tab--active="controls_style == 'Classic'"
                            data-event-click="set_controls_style('Classic')"
                            style="nav-up: #tab_controls; nav-down: #input_row_button_0_0"
                        >Classic controls</button>
                    </div>
                </div>
                <div>
                    <button
                        class="button button--warning"
                        style="nav-down:#input_row_button_0_0"
                        data-event-click="reset_input_bindings_to_defaults"
                    >
                        <div class="button__label">Reset to defaults</div>
                    </button>
                </div>
            </div>
            <div class="config__wrapper input-config">
                <div class="input-config__horizontal-split">
                    <div class="input-config__mappings" data-event-mouseout="set_input_row_focus(-1)">
                        <div class="input-config__mappings-scroll">
                            <div class="input-config__mappings-wrapper">
                                <div
                                    class="control-option"
                                    data-attr-id="'input_row_' + i"
                                    data-for="input_bindings, i : inputs.array"
                                    data-event-mouseover="set_input_row_focus(i)"
                                    data-class-control-option--active="get_input_enum_name(i)==cur_input_row"
                                    data-if="input_row_visible(i, controls_style, input_device_is_keyboard)"
                                >
                                    <label
                                        class="control-option__label"
                                    >{{get_input_name(i)}}</label>
                                    <div class="control-option__bindings">
                                        <button
                                            data-attr-id="'input_row_button_' + i + '_' + j"
                                            data-event-blur="set_input_row_focus(-1)"
                                            data-event-focus="set_input_row_focus(i)"
                                            data-for="cur_binding, j : input_bindings"
                                            data-event-click="set_input_binding(i,j)"
                                            class="prompt-font control-option__binding"
                                            data-attr-bind-slot="j"
                                            data-attr-style="i == 0 ? 'nav-up:#cont_kb_toggle' : 'nav-up:auto'"
                                        >
                                            <div class="control-option__binding-recording">
                                                <div class="control-option__binding-circle" />
                                                <div class="control-option__binding-edge">
                                                    <svg class="control-option__binding-edge-svg" src="icons/RecordBorder.svg" />
                                                </div>
                                            </div>
                                            <div class="control-option__binding-icon">{{cur_binding}}</div>
                                        </button>
                                    </div>
                                    <button
                                        data-if="get_input_enum_name(i) != 'TOGGLE_MENU' && get_input_enum_name(i) != 'ACCEPT_MENU'"
                                        data-event-blur="set_input_row_focus(-1)"
                                        data-event-focus="set_input_row_focus(i)"
                                        data-event-click="clear_input_bindings(i)"
                                        class="icon-button icon-button--error"
                                        data-attr-style="i == 0 ? 'nav-up:#cont_kb_toggle' : 'nav-up:auto'"
                                    >
                                        <svg src="icons/Trash.svg" />
                                    </button>
                                    <button
                                        data-if="get_input_enum_name(i) == 'TOGGLE_MENU' || get_input_enum_name(i) == 'ACCEPT_MENU'"
                                        data-event-blur="set_input_row_focus(-1)"
                                        data-event-focus="set_input_row_focus(i)"
                                        data-event-click="reset_single_input_binding_to_default(i)"
                                        class="icon-button icon-button--error"
                                        data-attr-style="i == 0 ? 'nav-up:#cont_kb_toggle' : 'nav-up:auto'"
                                    >
                                        <svg src="icons/Reset.svg" />
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- The pad: what each control does, by position (the controller's bindings, worked out in ui_config.cpp's
                         PadView), laid out like Steam's controller pages. The keyboard has only the list. -->
                    <div class="pad-map" data-if="!input_device_is_keyboard">
                        <div class="pad-map__top">
                            <div class="pad-map__side">
                                <div class="pad-map__row pad-map__row--left" data-for="row : inputs.pad.left" data-class-pad-map__row--lit="row.lit">
                                    <div class="pad-map__actions">
                                        <div data-for="line : row.lines">{{line.text}}</div>
                                        <div class="pad-map__none" data-if="row.lines.size == 0">--</div>
                                    </div>
                                    <div class="pad-map__glyph" data-class-pad-map__glyph--text="row.glyph_is_text">{{row.glyph}}</div>
                                </div>
                            </div>
                            <div class="pad-map__drawing">
                                <div class="pad-map__drawing-aspect">
                                    <svg class="pad-map__outline" src="icons/VizMap/ModernPad.svg" />
                                    <svg class="pad-map__lit" src="icons/VizMap/ModernPad_lt.svg" data-if="inputs.pad.spots.lt" />
                                    <svg class="pad-map__lit" src="icons/VizMap/ModernPad_rt.svg" data-if="inputs.pad.spots.rt" />
                                    <svg class="pad-map__lit" src="icons/VizMap/ModernPad_lb.svg" data-if="inputs.pad.spots.lb" />
                                    <svg class="pad-map__lit" src="icons/VizMap/ModernPad_rb.svg" data-if="inputs.pad.spots.rb" />
                                    <svg class="pad-map__lit" src="icons/VizMap/ModernPad_view.svg" data-if="inputs.pad.spots.view" />
                                    <svg class="pad-map__lit" src="icons/VizMap/ModernPad_menu.svg" data-if="inputs.pad.spots.menu" />
                                    <svg class="pad-map__lit" src="icons/VizMap/ModernPad_dpad_up.svg" data-if="inputs.pad.spots.dpad_up" />
                                    <svg class="pad-map__lit" src="icons/VizMap/ModernPad_dpad_down.svg" data-if="inputs.pad.spots.dpad_down" />
                                    <svg class="pad-map__lit" src="icons/VizMap/ModernPad_dpad_left.svg" data-if="inputs.pad.spots.dpad_left" />
                                    <svg class="pad-map__lit" src="icons/VizMap/ModernPad_dpad_right.svg" data-if="inputs.pad.spots.dpad_right" />
                                    <svg class="pad-map__lit" src="icons/VizMap/ModernPad_ls.svg" data-if="inputs.pad.spots.ls" />
                                    <svg class="pad-map__lit" src="icons/VizMap/ModernPad_l3.svg" data-if="inputs.pad.spots.l3" />
                                    <svg class="pad-map__lit" src="icons/VizMap/ModernPad_rs.svg" data-if="inputs.pad.spots.rs" />
                                    <svg class="pad-map__lit" src="icons/VizMap/ModernPad_r3.svg" data-if="inputs.pad.spots.r3" />
                                    <svg class="pad-map__lit" src="icons/VizMap/ModernPad_y.svg" data-if="inputs.pad.spots.y" />
                                    <svg class="pad-map__lit" src="icons/VizMap/ModernPad_x.svg" data-if="inputs.pad.spots.x" />
                                    <svg class="pad-map__lit" src="icons/VizMap/ModernPad_b.svg" data-if="inputs.pad.spots.b" />
                                    <svg class="pad-map__lit" src="icons/VizMap/ModernPad_a.svg" data-if="inputs.pad.spots.a" />
                                </div>
                            </div>
                            <div class="pad-map__side">
                                <div class="pad-map__row pad-map__row--right" data-for="row : inputs.pad.right" data-class-pad-map__row--lit="row.lit">
                                    <div class="pad-map__glyph" data-class-pad-map__glyph--text="row.glyph_is_text">{{row.glyph}}</div>
                                    <div class="pad-map__actions">
                                        <div data-for="line : row.lines">{{line.text}}</div>
                                        <div class="pad-map__none" data-if="row.lines.size == 0">--</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="pad-map__sections">
                            <div class="pad-map__section">
                                <div class="pad-map__heading">LEFT STICK</div>
                                <div class="pad-map__row pad-map__row--right" data-for="row : inputs.pad.left_stick" data-class-pad-map__row--lit="row.lit">
                                    <div class="pad-map__glyph" data-class-pad-map__glyph--text="row.glyph_is_text">{{row.glyph}}</div>
                                    <div class="pad-map__actions">
                                        <div data-for="line : row.lines">{{line.text}}</div>
                                        <div class="pad-map__none" data-if="row.lines.size == 0">--</div>
                                    </div>
                                </div>
                            </div>
                            <div class="pad-map__section">
                                <div class="pad-map__heading">DIRECTIONAL PAD</div>
                                <div class="pad-map__row pad-map__row--right" data-for="row : inputs.pad.dpad" data-class-pad-map__row--lit="row.lit">
                                    <div class="pad-map__glyph" data-class-pad-map__glyph--text="row.glyph_is_text">{{row.glyph}}</div>
                                    <div class="pad-map__actions">
                                        <div data-for="line : row.lines">{{line.text}}</div>
                                        <div class="pad-map__none" data-if="row.lines.size == 0">--</div>
                                    </div>
                                </div>
                            </div>
                            <div class="pad-map__section">
                                <div class="pad-map__heading">RIGHT STICK</div>
                                <div class="pad-map__row pad-map__row--right" data-for="row : inputs.pad.right_stick" data-class-pad-map__row--lit="row.lit">
                                    <div class="pad-map__glyph" data-class-pad-map__glyph--text="row.glyph_is_text">{{row.glyph}}</div>
                                    <div class="pad-map__actions">
                                        <div data-for="line : row.lines">{{line.text}}</div>
                                        <div class="pad-map__none" data-if="row.lines.size == 0">--</div>
                                    </div>
                                </div>
                            </div>
                            <div class="pad-map__section">
                                <div class="pad-map__heading">FACE BUTTONS</div>
                                <div class="pad-map__row pad-map__row--right" data-for="row : inputs.pad.face" data-class-pad-map__row--lit="row.lit">
                                    <div class="pad-map__glyph" data-class-pad-map__glyph--text="row.glyph_is_text">{{row.glyph}}</div>
                                    <div class="pad-map__actions">
                                        <div data-for="line : row.lines">{{line.text}}</div>
                                        <div class="pad-map__none" data-if="row.lines.size == 0">--</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </body>
</template>
    